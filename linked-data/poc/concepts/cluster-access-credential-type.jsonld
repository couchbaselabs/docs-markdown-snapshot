{
  "@context": "https://docs.couchbase.com/ld/context.jsonld",
  "@id": "https://docs.couchbase.com/ld/concepts/cluster-access-credential-type",
  "@type": "skos:ConceptScheme",
  "label": "Capella cluster access credential type",
  "enumValues": ["Basic", "Advanced"],
  "comment": "The axis Capella's index-statement pages gate execution on, in place of server/'s named RBAC privileges. Modeled as a scheme with a flat literal list, same pattern as index-state, for the same reason: nothing yet references 'Basic' or 'Advanced' as an individual concept on its own."
}
